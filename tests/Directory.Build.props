<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Two rules that make sense for production code and actively fight test code:
      CS1591 (missing XML doc): test classes and [Fact] methods are not a public API
      surface; the test name is the documentation. GenerateDocumentationFile off entirely
      removes the requirement rather than suppressing the warning one by one.
      CA1707 (no underscores in identifiers): Given_When_Then style test names are the
      readable convention here and in most .NET test suites; enforcing PascalCase-only
      method names makes long scenario names far harder to read.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA2007 (missing ConfigureAwait(false)) exists to prevent deadlocks under a capturing
      SynchronizationContext, a WPF/WinForms/old-ASP.NET concern. xUnit's runner doesn't
      have one, so the rule has no real payoff here and just fights "await using" and
      "await foreach", which can't carry ConfigureAwait at the declaration site at all.
    -->
    <!--
      CA1515 ("can be made internal") flags every public test class. xUnit discovers tests
      by scanning the assembly either way, and a test class is never part of a public API
      surface by definition, so there's nothing this rule protects here.
    -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515</NoWarn>
  </PropertyGroup>
</Project>
