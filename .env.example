# Copy to .env for local docker compose use. Real values in production come from
# Kubernetes secrets (see docs/DEVOPS.md §3) -- never commit a filled-in .env.

# Postgres
POSTGRES_DB=spotlys
POSTGRES_USER=spotlys
POSTGRES_PASSWORD=devpassword

# Spotlys.Api / Spotlys.Ingestion / Spotlys.Migrator
ConnectionStrings__Spotlys=Host=localhost;Port=5432;Database=spotlys;Username=spotlys;Password=devpassword

# MET Locationforecast requires a descriptive User-Agent with a real contact address
# (docs/DATA.md §2) -- generic agents get blocked.
MET_USER_AGENT=spotlys/1.0 (https://spotlys.no; contact@example.com)
