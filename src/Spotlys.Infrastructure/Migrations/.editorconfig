# EF Core scaffolds this folder's files; every migration hits CA1062 (unchecked
# migrationBuilder parameter) and similar rules that make sense for hand-authored code but
# not for generated Up()/Down() methods. Relaxed here rather than re-adding
# <auto-generated /> headers by hand to every future migration.
[*.cs]
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CS1591.severity = none
